    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8d97a1",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#f5a372"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#7dc2f5"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#a8aef5"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#a8aef5"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#a8aef5",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#7de398"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#7dc2f5"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#bda6f5"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#1a1e24",
                "background": "#f57a8a"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#7db0f5"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#7dc2f5",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#66cede"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#f5a372"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#f5c075"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#a8aef5",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#bda6f5"
            }
        }
    ]
}