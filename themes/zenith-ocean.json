    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8b949e",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#ffa76b"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#70c8ff"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#a5b0ff"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#a5b0ff"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#a5b0ff",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#6ee89a"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#70c8ff"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#c5a8ff"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#0a0e14",
                "background": "#ff7085"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#6eb4ff"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#70c8ff",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#4dd4e6"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#ffa76b"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#ffc76e"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#a5b0ff",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#c5a8ff"
            }
        }
    ]
}