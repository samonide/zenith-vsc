    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#5d5f70",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#b8826a"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#4a9aae"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#8476b8"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#8476b8"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#8476b8",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#5fad77"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#4a9aae"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#9278b8"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#0f1014",
                "background": "#ff879d"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#5a7dbd"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#4a9aae",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#5290a3"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#b8826a"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#b8826a"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#8476b8",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#9278b8"
            }
        },
        {
            "scope": [
                "meta.property-name",
                "support.property-value"
            ],
            "settings": {
                "foreground": "#9278b8"
            }
        },
        {
            "scope": "punctuation",
            "settings": {
                "foreground": "#a6a2c0"
            }
        },
        {
            "scope": [
                "markup.heading",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#8476b8",
                "fontStyle": "bold"
            }
        },
        {
            "scope": "markup.bold",
            "settings": {
                "foreground": "#b8826a",
                "fontStyle": "bold"
            }
        },
        {
            "scope": "markup.italic",
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": "markup.underline.link",
            "settings": {
                "foreground": "#5a7dbd"
            }
        },
        {
            "scope": "markup.inline.raw",
            "settings": {
                "foreground": "#5fad77"
            }
        },
        {
            "scope": "markup.list",
            "settings": {
                "foreground": "#8476b8"
            }
        },
        {
            "scope": "meta.diff.header",
            "settings": {
                "foreground": "#5d5f70"
            }
        },
        {
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#7ae89d"
            }
        },
        {
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#ff879d"
            }
        },
        {
            "scope": "markup.changed",
            "settings": {
                "foreground": "#f5d99f"
            }
        }
    ]
}