    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#635d82",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#f5ad88"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#5fc8e8"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#b39ef5"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#b39ef5"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#b39ef5",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#82e8a1"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#5fc8e8"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#c89ef5"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#0f0e1a",
                "background": "#ff879d"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#7aa2ff"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#5fc8e8",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#6bb8d9"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#f5ad88"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#f5d99f"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#b39ef5",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#c89ef5"
            }
        }
    ]
}