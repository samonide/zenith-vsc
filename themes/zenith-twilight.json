    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#757090",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#f5af72"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#7db5cc"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#bd96f5"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#bd96f5"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#bd96f5",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#8dd588"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#7db5cc"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#b3a6f0"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#1d1d28",
                "background": "#f58899"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#7d98f5"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#7db5cc",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#68bde0"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#f5af72"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#f2dca8"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#bd96f5",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#b3a6f0"
            }
        }
    ]
}