    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#6b6888",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#ffb86c"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#6db8d4"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#9d8dff"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#9d8dff"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#9d8dff",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#7fd97f"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#6db8d4"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#c58dff"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#0d0d18",
                "background": "#ff7b9c"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#6d8fff"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#6db8d4",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#4fc1e9"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#ffb86c"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#f9e2af"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#9d8dff",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#c58dff"
            }
        }
    ]
}