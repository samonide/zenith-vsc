    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8a8a8a",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#c4b8cc"
            }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#b8c0cc"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "support.variable"
            ],
            "settings": {
                "foreground": "#c8b8c6"
            }
        },
        {
            "name": "String",
            "scope": [
                "string"
            ],
            "settings": {
                "foreground": "#b4c8bc"
            }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#ccc4b8"
            }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "support.constant"
            ],
            "settings": {
                "foreground": "#ccc4b8"
            }
        },
        {
            "name": "Type/Class",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#b8c8cc"
            }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#b8c0cc"
            }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator"
            ],
            "settings": {
                "foreground": "#c4b8cc"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation"
            ],
            "settings": {
                "foreground": "#e8e8e8"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag"
            ],
            "settings": {
                "foreground": "#c8b4b4"
            }
        },
        {
            "name": "Attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#ccc8b4"
            }
        },
        {
            "name": "Escape Character",
            "scope": [
                "constant.character.escape"
            ],
            "settings": {
                "foreground": "#b8c8cc"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#c8b4b4"
            }
        }
    ]
}