    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#4d4d4d",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#907459"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#5a8c94"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#6e6090"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#6e6090"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#6e6090",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#608768"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#5a8c94"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#9a9a9a"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#0d0d0d",
                "background": "#888888"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#6079a8"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#5a8c94",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#5a7d90"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#907459"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#907459"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#6e6090",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#9a9a9a"
            }
        },
        {
            "scope": [
                "meta.property-name",
                "support.property-value"
            ],
            "settings": {
                "foreground": "#9a9a9a"
            }
        },
        {
            "scope": "punctuation",
            "settings": {
                "foreground": "#6e6e6e"
            }
        }
    ]
}