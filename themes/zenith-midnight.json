    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#7682ac",
                "fontStyle": "italic"
            }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.template"
            ],
            "settings": {
                "foreground": "#e8ecb1"
            }
        },
        {
            "name": "String Escape",
            "scope": [
                "constant.character.escape"
            ],
            "settings": {
                "foreground": "#dda3c8"
            }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#e8c79d"
            }
        },
        {
            "name": "Boolean",
            "scope": [
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#e88d94"
            }
        },
        {
            "name": "Constant",
            "scope": [
                "constant.language",
                "constant.other"
            ],
            "settings": {
                "foreground": "#b8a4e8"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.cast",
                "keyword.operator.sizeof",
                "keyword.operator.logical",
                "storage.modifier",
                "storage.type"
            ],
            "settings": {
                "foreground": "#7ec9a4"
            }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "keyword.operator.logical"
            ],
            "settings": {
                "foreground": "#7eb8d4"
            }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#dda3c8"
            }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#7eb8d4"
            }
        },
        {
            "name": "Built-in Type",
            "scope": [
                "support.type.primitive",
                "storage.type.built-in"
            ],
            "settings": {
                "foreground": "#7eb8d4"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other"
            ],
            "settings": {
                "foreground": "#b8a4e8"
            }
        },
        {
            "name": "Variable Property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "variable.other.member"
            ],
            "settings": {
                "foreground": "#b8a4e8"
            }
        },
        {
            "name": "Variable Parameter",
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#b8a4e8"
            }
        },
        {
            "name": "Object Property",
            "scope": [
                "meta.object-literal.key",
                "meta.field.declaration"
            ],
            "settings": {
                "foreground": "#b8a4e8"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.definition.block",
                "punctuation.section.embedded"
            ],
            "settings": {
                "foreground": "#7d87bc"
            }
        },
        {
            "name": "Brackets",
            "scope": [
                "meta.brace",
                "punctuation.section",
                "punctuation.definition.parameters",
                "punctuation.definition.array",
                "punctuation.definition.typeparameters"
            ],
            "settings": {
                "foreground": "#7d87bc"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag"
            ],
            "settings": {
                "foreground": "#7eb8d4"
            }
        },
        {
            "name": "Tag Attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#dda3c8"
            }
        },
        {
            "name": "Import/Include",
            "scope": [
                "keyword.control.import",
                "keyword.control.from",
                "keyword.control.export",
                "meta.import",
                "meta.export"
            ],
            "settings": {
                "foreground": "#7ec9a4"
            }
        },
        {
            "name": "Special",
            "scope": [
                "constant.other.placeholder",
                "variable.language"
            ],
            "settings": {
                "foreground": "#b8a4e8"
            }
        },
        {
            "name": "Macro",
            "scope": [
                "entity.name.function.macro",
                "meta.preprocessor"
            ],
            "settings": {
                "foreground": "#b8a4e8"
            }
        },
        {
            "name": "CSS Class",
            "scope": [
                "entity.other.attribute-name.class.css"
            ],
            "settings": {
                "foreground": "#e8ecb1"
            }
        },
        {
            "name": "CSS ID",
