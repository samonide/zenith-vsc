    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#505a7e",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#faa07a"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#7dcfff"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#b4a7f5"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#b4a7f5"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#b4a7f5",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#7ce8dc"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#7dcfff"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#e4f0fb"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#1b1e28",
                "background": "#f87c8a"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#91b4d5"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#7dcfff",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#5de4c7"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#faa07a"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#fffac2"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#b4a7f5",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#d4a6f7"
            }
        }
    ]
}