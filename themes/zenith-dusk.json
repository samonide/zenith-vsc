    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8888a8",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#ffd88a"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#91d7e3"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#bba6f7"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#bba6f7"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#bba6f7",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#a6e3a1"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#91d7e3"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#d5b8f5"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#1e1e2e",
                "background": "#f5b5c8"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#89b4fa"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#91d7e3",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#7dd4ed"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#ffd88a"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#ffd88a"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#bba6f7",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#d5b8f5"
            }
        },
        {
            "scope": [
                "meta.property-name",
                "support.property-value"
            ],
            "settings": {
                "foreground": "#d5b8f5"
            }
        },
        {
            "scope": "punctuation",
            "settings": {
                "foreground": "#b8b5c9"
            }
        },
        {
            "scope": [
                "markup.heading",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#bba6f7",
                "fontStyle": "bold"
            }
        },
        {
            "scope": "markup.bold",
            "settings": {
                "foreground": "#ffd88a",
                "fontStyle": "bold"
            }
        },
        {
            "scope": "markup.italic",
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": "markup.underline.link",
            "settings": {
                "foreground": "#89b4fa"
            }
        },
        {
            "scope": "markup.inline.raw",
            "settings": {
                "foreground": "#a6e3a1"
            }
        },
        {
            "scope": "markup.list",
            "settings": {
                "foreground": "#bba6f7"
            }
        },
        {
            "scope": "meta.diff.header",
            "settings": {
                "foreground": "#8888a8"
            }
        },
        {
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#b5e5c5"
            }
        },
        {
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#f5b5c8"
            }
        },
        {
            "scope": "markup.changed",
            "settings": {
                "foreground": "#f5e5b8"
            }
