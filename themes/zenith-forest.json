    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#6a7d76",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#d5b380"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#80b5c7"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#9fb3d5"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#9fb3d5"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#9fb3d5",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#8dd49e"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#80b5c7"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#b5a6d2"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#1b1f1d",
                "background": "#d67d7d"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#80b8d0"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#80b5c7",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#6fbbb5"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#d5b380"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#d5b380"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#9fb3d5",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#b5a6d2"
            }
        },
        {
            "scope": [
                "meta.property-name",
                "support.property-value"
            ],
            "settings": {
                "foreground": "#b5a6d2"
            }
        },
        {
            "scope": "punctuation",
            "settings": {
                "foreground": "#859890"
            }
        },
        {
            "scope": [
                "markup.heading",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#9fb3d5",
                "fontStyle": "bold"
            }
        },
        {
            "scope": "markup.bold",
            "settings": {
                "foreground": "#d5b380",
                "fontStyle": "bold"
            }
        },
        {
            "scope": "markup.italic",
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": "markup.underline.link",
            "settings": {
                "foreground": "#80b8d0"
            }
        },
        {
            "scope": "markup.inline.raw",
            "settings": {
                "foreground": "#8dd49e"
            }
        },
        {
            "scope": "markup.list",
            "settings": {
                "foreground": "#9fb3d5"
            }
        },
        {
            "scope": "meta.diff.header",
            "settings": {
                "foreground": "#6a7d76"
            }
        },
        {
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#92d4a8"
            }
        },
        {
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#d67d7d"
            }
        },
        {
            "scope": "markup.changed",
            "settings": {
                "foreground": "#ddc785"
            }
        }
    ]
}