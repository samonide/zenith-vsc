    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#5f7771",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#d9b77d"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#75b8c9"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#98b3d9"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#98b3d9"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#98b3d9",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#86d9a1"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#75b8c9"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#b5a3d6"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#0e1311",
                "background": "#d67575"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#7ab8d4"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#75b8c9",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#5fbfb8"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#d9b77d"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#d6c77e"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#98b3d9",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#b5a3d6"
            }
        }
    ]
}