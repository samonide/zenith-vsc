    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#667766",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#c8a8e0"
            }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#89c0eb"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "support.variable"
            ],
            "settings": {
                "foreground": "#f5a8c8"
            }
        },
        {
            "name": "String",
            "scope": [
                "string"
            ],
            "settings": {
                "foreground": "#81c995"
            }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#ffb86c"
            }
        },
        {
            "name": "Constant",
            "scope": [
                "constant",
                "support.constant"
            ],
            "settings": {
                "foreground": "#ffb86c"
            }
        },
        {
            "name": "Type/Class",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#89dceb"
            }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#89c0eb"
            }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator"
            ],
            "settings": {
                "foreground": "#c8a8e0"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation"
            ],
            "settings": {
                "foreground": "#e8f0e0"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag"
            ],
            "settings": {
                "foreground": "#f28b82"
            }
        },
        {
            "name": "Attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#f9e2af"
            }
        },
        {
            "name": "Escape Character",
            "scope": [
                "constant.character.escape"
            ],
            "settings": {
                "foreground": "#89dceb"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#f28b82"
            }
        }
    ]
}