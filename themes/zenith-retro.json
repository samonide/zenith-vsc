    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8e8070",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#e5b580"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#98c2d7"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#b3aee3"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#b3aee3"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#b3aee3",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#a8d89c"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#98c2d7"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#c8b3e0"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#1e1d1b",
                "background": "#e39a9a"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#8fb5db"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#98c2d7",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#88cec4"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#e5b580"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#e0c88e"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#b3aee3",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#c8b3e0"
            }
        }
    ]
}