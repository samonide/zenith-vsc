    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8a7d6e",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#e9b882"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#9bc5db"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#b8b3e8"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#b8b3e8"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#b8b3e8",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#aedb9e"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#9bc5db"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#cdb5e5"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#1a1410",
                "background": "#e39a9a"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#92b8e3"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#9bc5db",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#8dd4c8"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#e9b882"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#e5cd90"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#b8b3e8",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#cdb5e5"
            }
        }
    ]
}