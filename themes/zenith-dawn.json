    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8b83a0",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "variable.language"
            ],
            "settings": {
                "foreground": "#d97706"
            }
        },
        {
            "scope": [
                "entity",
                "entity.name"
            ],
            "settings": {
                "foreground": "#1a8fb8"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#7c3fed"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#7c3fed"
            }
        },
        {
            "scope": [
                "storage",
                "storage.type"
            ],
            "settings": {
                "foreground": "#7c3fed",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#4e9f3d"
            }
        },
        {
            "scope": "support",
            "settings": {
                "foreground": "#1a8fb8"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#9854d6"
            }
        },
        {
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#faf7f3",
                "background": "#d41f5c"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "support.function"
            ],
            "settings": {
                "foreground": "#3d6fd6"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#1a8fb8",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#1e9eb3"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#d97706"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#d97706"
            }
        },
        {
            "scope": "keyword.control",
            "settings": {
                "foreground": "#7c3fed",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "variable.other.property",
            "settings": {
                "foreground": "#9854d6"
            }
        },
        {
            "scope": [
                "meta.property-name",
                "support.property-value"
            ],
            "settings": {
                "foreground": "#9854d6"
            }
        },
        {
            "scope": "punctuation",
            "settings": {
                "foreground": "#514a58"
            }
        },
        {
            "scope": [
                "markup.heading",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#7c3fed",
                "fontStyle": "bold"
            }
        },
        {
            "scope": "markup.bold",
            "settings": {
                "foreground": "#d97706",
                "fontStyle": "bold"
            }
        },
        {
            "scope": "markup.italic",
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": "markup.underline.link",
            "settings": {
                "foreground": "#3d6fd6"
            }
        },
        {
            "scope": "markup.inline.raw",
            "settings": {
                "foreground": "#4e9f3d"
            }
        },
        {
            "scope": "markup.list",
            "settings": {
                "foreground": "#7c3fed"
            }
        },
        {
            "scope": "meta.diff.header",
            "settings": {
                "foreground": "#8b83a0"
            }
        },
        {
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#3d9970"
            }
        },
        {
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#d41f5c"
            }
        },
        {
            "scope": "markup.changed",
            "settings": {
                "foreground": "#c79316"
            }
        }
    ]
}