    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#6a8088",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "keyword.other"
            ],
            "settings": {
                "foreground": "#ba91aa"
            }
        },
        {
            "name": "Control Keywords",
            "scope": [
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical"
            ],
            "settings": {
                "foreground": "#ba91aa",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.relational",
                "keyword.operator.bitwise",
                "keyword.operator.logical.python"
            ],
            "settings": {
                "foreground": "#a091ba"
            }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.quoted.double",
                "string.quoted.single",
                "string.quoted.triple"
            ],
            "settings": {
                "foreground": "#80baa0"
            }
        },
        {
            "name": "String Interpolation",
            "scope": [
                "punctuation.definition.template-expression",
                "meta.template.expression",
                "meta.embedded.line",
                "meta.embedded"
            ],
            "settings": {
                "foreground": "#a091ba"
            }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#baaa8c"
            }
        },
        {
            "name": "Constant",
            "scope": [
                "constant.language",
                "constant.character",
                "constant.other",
                "variable.other.constant",
                "variable.other.enummember",
                "support.constant"
            ],
            "settings": {
                "foreground": "#ba9380"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other.readwrite",
                "variable.other",
                "variable.language",
                "variable.parameter.function"
            ],
            "settings": {
                "foreground": "#80a6ba"
            }
        },
        {
            "name": "Variable Property",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "meta.object-literal.key.js",
                "meta.object-literal.key.ts"
            ],
            "settings": {
                "foreground": "#80a6ba"
            }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call.generic",
                "meta.function-call",
                "variable.function"
            ],
            "settings": {
                "foreground": "#78aaa8"
            }
        },
        {
            "name": "Method",
            "scope": [
                "entity.name.method",
                "meta.method-call",
                "meta.method.declaration"
            ],
            "settings": {
                "foreground": "#78aaa8"
            }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "entity.name.type.class",
                "support.class",
                "support.type",
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#938bba"
            }
        },
        {
            "name": "Type Annotation",
            "scope": [
                "meta.type.annotation",
                "meta.type.declaration",
                "entity.name.type.parameter",
                "support.type.primitive"
            ],
            "settings": {
                "foreground": "#938bba"
            }
        },
        {
            "name": "Parameter",
            "scope": [
                "variable.parameter",
                "meta.parameters",
                "parameter.variable"
            ],
            "settings": {
                "foreground": "#80a6ba"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag"
            ],
            "settings": {
                "foreground": "#938bba"
            }
        },
        {
            "name": "Tag Attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#ba91aa"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation"
            ],
            "settings": {
                "foreground": "#a8bcc2"
            }
        },
        {
            "name": "Python Decorator",
            "scope": [
                "entity.name.function.decorator.python",
                "meta.function.decorator.python"
            ],
            "settings": {
                "foreground": "#ba91aa",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Python Self",
            "scope": [
                "variable.language.special.self.python",
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": {
                "foreground": "#ba91aa",
                "fontStyle": "italic"
            }
        },
        {
            "name": "This/Super",
            "scope": [
                "variable.language.this",
                "variable.language.super"
            ],
            "settings": {
                "foreground": "#ba91aa",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Built-in Functions",
            "scope": [
                "support.function.builtin",
                "support.function.magic.python"
            ],
            "settings": {
                "foreground": "#78aaa8"
            }
        },
        {
            "name": "JSON Key",
            "scope": [
                "support.type.property-name.json",
                "meta.object-literal.key"
            ],
            "settings": {
                "foreground": "#938bba"
            }
        },
        {
            "name": "CSS Selector",
            "scope": [
                "entity.name.tag.css",
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": {
                "foreground": "#938bba"
            }
        },
        {
            "name": "CSS Property",
            "scope": [
                "support.type.property-name.css"
            ],
            "settings": {
                "foreground": "#80a6ba"
            }
        },
        {
            "name": "Markdown Heading",
            "scope": [
                "markup.heading",
                "entity.name.section.markdown"
            ],
            "settings": {
                "foreground": "#ba91aa",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown Bold",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#ba9380",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown Italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#80a6ba",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown Code",
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code"
            ],
            "settings": {
                "foreground": "#80baa0"
            }
        },
        {
            "name": "Markdown Link",
            "scope": [
                "markup.underline.link"
            ],
            "settings": {
                "foreground": "#78aaa8"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#e8a5b8"
            }
        },
        {
            "name": "Deprecated",
            "scope": [
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#e8c4a0",
                "fontStyle": "strikethrough"
            }
        }
    ]
}